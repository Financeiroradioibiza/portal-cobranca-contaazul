# Proxy API → portal (same-origin no browser). Requer netlify.toml para header X-Chamados-App-Proxy.
# Se vir loop 308 em /api/chamados, o site Netlify está com plugin Next.js ou base directory errada.

/api/chamados-app/*  https://portal.radioibiza.app.br/api/chamados-app/:splat  200!
/api/auth/*  https://portal.radioibiza.app.br/api/auth/:splat  200!
/api/chamados  https://portal.radioibiza.app.br/api/chamados  200!
/api/chamados/*  https://portal.radioibiza.app.br/api/chamados/:splat  200!
/api/push/*  https://portal.radioibiza.app.br/api/push/:splat  200!

/login  /login.html  200
/  /app.html  200
